# Ecommerce backend configuration
# Copy to .env and fill in local credentials. Never commit .env.

ENV=development
PORT=8000

# Database (PostgreSQL only). Tests use TEST_DATABASE_URL.

DATABASE_URL=
TEST_DATABASE_URL=

# Public URLs (production must use HTTPS origins)
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5173/api

# Session cookie
SESSION_COOKIE_NAME=ecommerce_session
SESSION_MAX_AGE_SECONDS=1209600
SESSION_COOKIE_SECURE=false

# Rate limiting HMAC key (server-only secret, stable across workers/restarts)
RATE_LIMIT_HMAC_KEY=

# Trusted proxy CIDRs (empty locally; set real proxy ranges in production)
TRUSTED_PROXY_CIDRS=

# Razorpay (test mode for development/staging)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=<server-only-test-secret>
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_PUBLIC_URL=https://<staging-api-host>/api/webhooks/razorpay

# Store / money
STORE_CURRENCY=USD
SHIPPING_FLAT_RATE_MINOR=0
DOWNLOAD_LINK_TTL_SECONDS=900

# Storage
UPLOAD_MAX_IMAGE_BYTES=5242880
STORAGE_BACKEND=local
STORAGE_LOCAL_DIRECTORY=./storage
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# OAuth (callbacks must match the storefront origin /api proxy exactly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/oauth/github/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:5173/api/auth/oauth/microsoft/callback

# Email (console receipt logging in development)
EMAIL_MODE=console

# Seed admin (development only; never ship a fixed default password)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
